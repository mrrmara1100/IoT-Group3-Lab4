  {
    "id": "t4_fmt",
    "type": "function",
    "z": "t4_tab",
    "name": "Format for InfluxDB",
    "func": "// Turn the ESP32 packet into InfluxDB fields + tags: [fields, tags]\nconst d = msg.payload;\nconst fields = {};\nfor (const k of [\"gas_raw\", \"gas_avg\", \"risk_code\", \"body_temp\", \"fever_flag\", \"pressure\", \"altitude\"]) {\n    if (typeof d[k] === \"number\") fields[k] = d[k] * 1.0;\n}\nif (d.risk_level) fields.risk_level = String(d.risk_level);\nif (d.timestamp) fields.ds3231_time = String(d.timestamp);\nmsg.payload = [fields, { device: \"esp32\" }];\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 180,
    "wires": [
      [
        "t4_influx_out",
        "t4_debug_db"
      ]
    ]
  },
