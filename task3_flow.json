[
  {
    "id": "t3_tab",
    "type": "tab",
    "label": "Lab4 Task3 - Fever",
    "disabled": false
  },
  {
    "id": "t3_broker",
    "type": "mqtt-broker",
    "name": "broker.hivemq.com",
    "broker": "broker.hivemq.com",
    "port": "1883",
    "clientid": "",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "t3_mqtt_in",
    "type": "mqtt in",
    "z": "t3_tab",
    "name": "Body temp data",
    "topic": "lab4/task3/data",
    "qos": "0",
    "datatype": "json",
    "broker": "t3_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 130,
    "y": 120,
    "wires": [
      [
        "t3_debug",
        "t3_split"
      ]
    ]
  },
  {
    "id": "t3_debug",
    "type": "debug",
    "z": "t3_tab",
    "name": "Fever packet",
    "active": true,
    "tosidebar": true,
    "console": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 400,
    "y": 60,
    "wires": []
  },
  {
    "id": "t3_split",
    "type": "function",
    "z": "t3_tab",
    "name": "Split temp / fever",
    "func": "const d = msg.payload;\nconst fever = d.fever_flag === 1;\nreturn [\n    { topic: \"body_temp\", payload: d.body_temp },\n    { topic: \"fever_flag\", payload: fever ? \"FEVER (fever_flag = 1)\" : \"Normal (fever_flag = 0)\",\n      color: fever ? \"#c62828\" : \"#2e7d32\" }\n];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 160,
    "wires": [
      [
        "t3_gauge",
        "t3_chart"
      ],
      [
        "t3_fever"
      ]
    ]
  },
  {
    "id": "t3_ui_tab",
    "type": "ui_tab",
    "name": "Lab4 Task3",
    "icon": "dashboard",
    "order": 1,
    "disabled": false,
    "hidden": false
  },
  {
    "id": "t3_ui_group",
    "type": "ui_group",
    "name": "Fever Detection (MLX90614)",
    "tab": "t3_ui_tab",
    "order": 1,
    "disp": true,
    "width": "6",
    "collapse": false
  },
  {
    "id": "t3_gauge",
    "type": "ui_gauge",
    "z": "t3_tab",
    "name": "Body temperature",
    "group": "t3_ui_group",
