    "width": 0,
    "height": 0,
    "gtype": "gage",
    "title": "Body temperature",
    "label": "°C",
    "format": "{{value | number:1}}",
    "min": 20,
    "max": 45,
    "colors": [
      "#00b500",
      "#ca3838",
      "#8b0000"
    ],
    "seg1": "32.5",
    "seg2": "38",
    "x": 640,
    "y": 120,
    "wires": []
  },
  {
    "id": "t3_fever",
    "type": "ui_text",
    "z": "t3_tab",
    "group": "t3_ui_group",
    "order": 1,
    "width": 0,
    "height": 0,
    "name": "Status",
    "label": "Status",
    "format": "<b style=\"color:{{msg.color}};font-size:1.6em\">{{msg.payload}}</b>",
    "layout": "row-spread",
    "x": 640,
    "y": 200,
    "wires": []
  },
  {
    "id": "t3_chart",
    "type": "ui_chart",
    "z": "t3_tab",
